<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.ad0bert</groupId>
  <artifactId>ai-slop-teroids</artifactId>
  <version>0.6.0-SNAPSHOT</version>

  <name>AISlopTeroids</name>
  <description>A 3D first-person take on the classic Asteroids, built on EngineNamedScratch.</description>

  <properties>
    <java.version>25</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <engine.version>0.8.5</engine.version>
    <logback.version>1.5.18</logback.version>
    <junit.version>6.1.3</junit.version>

    <dist.directory>${project.build.directory}/dist</dist.directory>
    <!-- for -Pjpackage: app-image (a folder), or an installer type such as deb, rpm, dmg, pkg, msi, exe -->
    <jpackage.type>app-image</jpackage.type>
    <!-- jpackage wants a plain numeric version with a first number above zero (macOS) -->
    <jpackage.version>1.0.0</jpackage.version>
    <jpackage.modules>java.base,java.desktop,java.logging,java.management,java.naming,java.xml,jdk.unsupported</jpackage.modules>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.ad0bert</groupId>
      <artifactId>engine-named-scratch</artifactId>
      <version>${engine.version}</version>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <version>${logback.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>ai-slop-teroids</finalName>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- text files with ${project.version} and the like; kept apart so binary files are never filtered -->
      <resource>
        <directory>src/main/resources-filtered</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.0</version>
      </plugin>
      <!-- target/dist/ai-slop-teroids.jar runs with `java -jar` and finds its dependencies in target/dist/lib -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <outputDirectory>${dist.directory}</outputDirectory>
          <archive>
            <manifest>
              <mainClass>aislopteroids.Main</mainClass>
              <addClasspath>true</addClasspath>
              <classpathPrefix>lib/</classpathPrefix>
            </manifest>
            <manifestEntries>
              <!-- JOGL, JOAL and JInput load native libraries -->
              <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>copy-dependencies</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${dist.directory}/lib</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      mvn package -Pgithub-packages: resolve the engine from GitHub Packages instead of a local `mvn install` of it.
      Needs a `github` server in ~/.m2/settings.xml with a token that can read packages (see README).
    -->
    <profile>
      <id>github-packages</id>
      <repositories>
        <repository>
          <id>github</id>
          <url>https://maven.pkg.github.com/ad0bert/EngineNamedScratch</url>
        </repository>
      </repositories>
    </profile>
    <!-- mvn package -Pjpackage: the game with its own Java runtime in target/jpackage (no Java needed to play) -->
    <profile>
      <id>jpackage</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.5.1</version>
            <executions>
              <execution>
                <id>jpackage</id>
                <phase>package</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${java.home}/bin/jpackage</executable>
                  <arguments>
                    <argument>--type</argument>
                    <argument>${jpackage.type}</argument>
                    <argument>--name</argument>
                    <argument>AISlopTeroids</argument>
                    <argument>--app-version</argument>
                    <argument>${jpackage.version}</argument>
                    <argument>--vendor</argument>
                    <argument>ad0bert</argument>
                    <argument>--input</argument>
                    <argument>${dist.directory}</argument>
                    <argument>--main-jar</argument>
                    <argument>ai-slop-teroids.jar</argument>
                    <argument>--main-class</argument>
                    <argument>aislopteroids.Main</argument>
                    <argument>--add-modules</argument>
                    <argument>${jpackage.modules}</argument>
                    <argument>--java-options</argument>
                    <argument>--enable-native-access=ALL-UNNAMED</argument>
                    <argument>--dest</argument>
                    <argument>${project.build.directory}/jpackage</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
